# The deployed Sitter contract on GenLayer Studio (chain 61999). Empty: lib/config.ts DEMO_CONTRACT is used.
# With both empty every page says the contract is not deployed yet; NEXT_PUBLIC_MOCK=1 still shows the whole site.
NEXT_PUBLIC_CONTRACT=

# 1: the site runs on an in-memory copy of the contract (lib/chain-mock.ts), with the demo sitter's fixed
# reports and the sitting page's report chips read as they are written to be; no wallet and no network. For
# local work and for showing the pages; never for a public deployment.
NEXT_PUBLIC_MOCK=0

# The public address of the site, used for the links in shared-link previews.
NEXT_PUBLIC_SITE_URL=

# The public source repository (https://github.com/<owner>/<name>), for the footer's Source link. On Vercel the
# repository the site was built from is used when this is empty (its NEXT_PUBLIC_VERCEL_GIT_* system variables).
NEXT_PUBLIC_REPO_URL=

# Server only. A throwaway Studio test key: the demo sitter (tools/open-demo-sitter.mjs checks it and funds it).
# POST /api/demo/accept and /api/demo/report sign with it: accept() on a booking made to it with one of the three
# demo care plans word for word, report() with one of that plan's fixed reports, and deposit() of its own credit
# for report fees. Never a key that holds anything real. Pasted with or without 0x, with or without quotes.
# Unset: the site works, and GET /api/demo/status says exactly why the demo sitter is away.
DEMO_SITTER_KEY=
